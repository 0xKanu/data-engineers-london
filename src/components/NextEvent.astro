---
export interface Props {
  title: string;
  date: Date;
  venue: string;
  description: string;
  meetupLink: string;
  eventId: string;
}

const { title, date, venue, description, meetupLink, eventId } = Astro.props;

const formattedDate = date.toLocaleDateString("en-GB", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<section class="py-24 bg-navy/95 border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-white inline-block relative">
        Next Meetup
        <div class="absolute -bottom-3 left-0 w-1/2 h-1 bg-orange rounded-full"></div>
      </h2>
    </div>
    <div class="bg-white/5 border border-green/30 rounded-2xl p-8 md:p-12 hover:border-green transition-colors backdrop-blur-sm">
      <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8">
        <div class="space-y-4 flex-1">
          <div class="flex flex-wrap items-center gap-3 text-sm">
            <span class="inline-flex items-center gap-1.5 text-green">
              <span class="material-symbols-outlined text-lg">calendar_month</span>
              {formattedDate}
            </span>
            <span class="text-text-muted">|</span>
            <span class="inline-flex items-center gap-1.5 text-text-secondary">
              <span class="material-symbols-outlined text-lg">location_on</span>
              {venue}
            </span>
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-white">
            <a href={`/events/${eventId}`} class="hover:text-green transition-colors">{title}</a>
          </h3>
          <p class="text-text-secondary font-light leading-normal max-w-2xl">{description}</p>
        </div>
        <div class="shrink-0">
          <a class="group inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-orange text-navy font-bold text-lg hover:bg-orange-dark transition-all hover:scale-105 hover:shadow-[0_0_30px_rgba(243,112,70,0.4)]" href={meetupLink} rel="noopener noreferrer" target="_blank">
            RSVP on Meetup
            <span class="material-symbols-outlined ml-2 group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
