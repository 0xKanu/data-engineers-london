---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import NextEvent from "../components/NextEvent.astro";
import About from "../components/About.astro";
import GetInvolved from "../components/GetInvolved.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const allEvents = await getCollection("events");
const now = new Date();

const upcoming = allEvents
  .filter((e) => e.data.date > now && e.id !== "july-2026-meetup")
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const sponsors = [
  { name: "Snowflake", domain: "snowflake.com" },
  { name: "Confluent", domain: "confluent.io" },
  { name: "Kubrick Group", domain: "kubrickgroup.com" },
  { name: "Sahaj Software", domain: "sahajsoft.com" },
  { name: "The Information Lab", domain: "theinformationlab.co.uk" },
  { name: "Census", domain: "getcensus.com" },
  { name: "Civo", domain: "civo.com" },
  { name: "Baringa", domain: "baringa.com" },
  { name: "Trainline", domain: "thetrainline.com" },
  { name: "Wise", domain: "wise.com" },
  { name: "Zego", domain: "zego.com" },
];

const nextEvent = upcoming[0];
---

<Base title="Data Engineers London — London’s Community for Data Engineers">
  <Header />
  <main id="main-content" class="flex-grow">
    <Hero />
    <About />
    {
      nextEvent ? (
        <NextEvent
          title={nextEvent.data.title}
          date={nextEvent.data.date}
          venue={nextEvent.data.venue}
          description={nextEvent.data.description}
          meetupLink={nextEvent.data.meetupLink}
          eventId={nextEvent.id}
        />
      ) : (
        <section class="py-24 bg-navy/95 border-t border-white/5">
          <div class="max-w-7xl mx-auto px-6">
            <div class="mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-white inline-block relative">
                Next Meetup
                <div class="absolute -bottom-3 left-0 w-1/2 h-1 bg-orange rounded-full"></div>
              </h2>
            </div>
            <div class="bg-white/5 border border-green/30 rounded-2xl p-8 md:p-12 backdrop-blur-sm text-center">
              <span class="material-symbols-outlined text-5xl text-white/50 mb-4 block">event</span>
              <p class="text-text-muted text-lg font-light">Our next meetup is being planned — check back soon.</p>
            </div>
          </div>
        </section>
      )
    }
    <GetInvolved />
    <section class="py-24 bg-navy/95 border-t border-white/5" id="sponsorship">
      <div class="max-w-7xl mx-auto px-6">
        <div class="mb-16 text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-white inline-block relative mb-6">
            Past Sponsors &amp; Partners
            <div class="absolute -bottom-3 left-0 w-1/2 h-1 bg-green rounded-full"></div>
          </h2>
          <p class="text-text-secondary text-lg max-w-2xl mx-auto font-light leading-normal">
            The organisations that have supported us since 2023.
          </p>
        </div>
      </div>

      <div class="overflow-hidden py-4">
        <div class="sponsor-track flex gap-4 px-6">
          {sponsors.map((s) => (
            <a href={`https://${s.domain}`} class="min-w-[180px] bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-green/50 hover:bg-white/10 transition-colors text-center backdrop-blur-sm shrink-0 group" rel="noopener noreferrer" target="_blank" role="listitem">
              <div class="bg-white/10 rounded-lg p-3 mb-3 flex items-center justify-center h-14">
                <img
                  src={`https://www.google.com/s2/favicons?domain=${s.domain}&sz=128`}
                  alt={s.name}
                  class="max-h-8 max-w-[120px] object-contain"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              </div>
              <span class="text-white text-sm font-medium group-hover:text-green transition-colors">{s.name}</span>
            </a>
          ))}
          {sponsors.map((s) => (
            <a href={`https://${s.domain}`} class="min-w-[180px] bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-green/50 hover:bg-white/10 transition-colors text-center backdrop-blur-sm shrink-0 group" rel="noopener noreferrer" target="_blank" role="listitem" aria-hidden="true">
              <div class="bg-white/10 rounded-lg p-3 mb-3 flex items-center justify-center h-14">
                <img
                  src={`https://www.google.com/s2/favicons?domain=${s.domain}&sz=128`}
                  alt={s.name}
                  class="max-h-8 max-w-[120px] object-contain"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              </div>
              <span class="text-white text-sm font-medium group-hover:text-green transition-colors">{s.name}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-6 mt-10 flex flex-col items-center">
        <a class="group relative inline-flex items-center justify-center px-10 py-4 rounded-full bg-orange text-navy font-bold text-lg hover:bg-orange-dark transition-all hover:scale-105 hover:shadow-[0_0_30px_rgba(243,112,70,0.4)]" href="mailto:events@dataengineerslondon.com">
          Interested in sponsoring? Get in Touch
          <span class="material-symbols-outlined ml-2 group-hover:translate-x-1 transition-transform">mail</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
