---
import { getCollection } from "astro:content";

const allEvents = await getCollection("events");
const eventCount = allEvents.filter((e) => e.id !== "july-2026-meetup").length;
---

<section class="py-24 bg-navy/95 border-t border-white/5 relative z-10" id="about">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white inline-block relative">
        About Us
        <div class="absolute -bottom-3 left-0 w-1/2 h-1 bg-green rounded-full"></div>
      </h2>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-24">
      <div class="space-y-6 text-text-body text-lg font-light leading-normal">
        <p>
          Data Engineers London is a community-driven group dedicated to bringing together data professionals, engineers, architects, and enthusiasts across the capital. We provide a space to share knowledge, discuss best practices, and explore the latest technologies shaping the modern data stack.
        </p>
        <p>
          Whether you’re building massive data pipelines, architecting real-time streaming platforms, or just starting your journey in data engineering, you’ll find a welcoming community ready to learn and grow together.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors group backdrop-blur-sm sm:col-span-2">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-xl bg-green/10 flex items-center justify-center text-green group-hover:scale-110 transition-transform">
              <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">groups</span>
            </div>
            <h3 class="text-3xl font-bold text-white">2,000+</h3>
          </div>
          <p class="text-text-dim font-medium">Active Members</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors group backdrop-blur-sm">
          <div class="w-12 h-12 rounded-xl bg-orange/10 flex items-center justify-center text-orange mb-4 group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">event</span>
          </div>
          <h3 class="text-2xl font-bold text-white mb-1">{eventCount}+</h3>
          <p class="text-text-dim text-sm font-medium">Events Hosted</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors group backdrop-blur-sm">
          <div class="w-12 h-12 rounded-xl bg-green/10 flex items-center justify-center text-green mb-4 group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">calendar_month</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-1">Monthly</h3>
          <p class="text-text-dim text-sm font-medium">Meetups</p>
        </div>
      </div>
    </div>
  </div>
</section>
