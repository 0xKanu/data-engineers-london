---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import NextEvent from "../components/NextEvent.astro";
import About from "../components/About.astro";
import GetInvolved from "../components/GetInvolved.astro";
import Sponsorship from "../components/Sponsorship.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const allEvents = await getCollection("events");
const now = new Date();

const upcoming = allEvents
  .filter((e) => e.data.date > now && e.id !== "july-2026-meetup")
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const nextEvent = upcoming[0];
---

<Base title="Data Engineers London — London's Community for Data Engineers">
  <Header />
  <main class="flex-grow">
    <Hero />
    {
      nextEvent ? (
        <NextEvent
          title={nextEvent.data.title}
          date={nextEvent.data.date}
          venue={nextEvent.data.venue}
          description={nextEvent.data.description}
          meetupLink={nextEvent.data.meetupLink}
          eventId={nextEvent.id}
        />
      ) : (
        <section class="py-24 bg-navy/95 border-t border-white/5">
          <div class="max-w-7xl mx-auto px-6">
            <div class="mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-white inline-block relative">
                Next Meetup
                <div class="absolute -bottom-3 left-0 w-1/2 h-1 bg-orange rounded-full"></div>
              </h2>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-2xl p-8 md:p-12 backdrop-blur-sm text-center">
              <span class="material-symbols-outlined text-5xl text-white/20 mb-4 block">event</span>
              <p class="text-white/50 text-lg font-light">Our next meetup is being planned — check back soon.</p>
            </div>
          </div>
        </section>
      )
    }
    <About />
    <GetInvolved />
    <Sponsorship />
  </main>
  <Footer />
</Base>
