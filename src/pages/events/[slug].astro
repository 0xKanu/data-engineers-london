---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events
    .filter((e) => e.id !== "july-2026-meetup")
    .map((event) => ({
      params: { slug: event.id },
      props: { event },
    }));
}

const { event } = Astro.props;
const { Content } = await render(event);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-GB", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}
---

<Base title={`${event.data.title} — Data Engineers London`} description={event.data.description}>
  <Header />
  <main id="main-content" class="flex-grow">

    <section class="relative pt-32 pb-24 lg:pt-48 lg:pb-32 overflow-hidden bg-grid-pattern">
      <div class="absolute inset-0 bg-gradient-to-b from-navy/50 to-navy z-0"></div>
      <div class="relative z-10 max-w-7xl mx-auto px-6">
        <a href="/events" class="inline-flex items-center text-green hover:text-green-light font-medium mb-8 group transition-colors">
          <span class="material-symbols-outlined mr-1 group-hover:-translate-x-1 transition-transform">arrow_back</span>
          All Events
        </a>
        <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-white mb-6">
          {event.data.title}
        </h1>
        <div class="flex flex-wrap items-center gap-4 text-sm md:text-base">
          <span class="inline-flex items-center gap-1.5 text-green">
            <span class="material-symbols-outlined">calendar_month</span>
            {formatDate(event.data.date)}
          </span>
          <span class="text-text-muted">|</span>
          <span class="inline-flex items-center gap-1.5 text-text-secondary">
            <span class="material-symbols-outlined">location_on</span>
            {event.data.venue}
          </span>
        </div>
      </div>
    </section>

    <section class="py-16 bg-navy/95 border-t border-white/5">
      <div class="max-w-3xl mx-auto px-6">

        {
          event.data.speakers.length > 0 && (
            <div class="mb-10">
              <h2 class="text-xl font-bold text-white mb-4">Speakers</h2>
              <div class="flex flex-wrap gap-3">
                {event.data.speakers.map((speaker: string) => (
                  <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-green/10 text-green text-sm font-medium">
                    <span class="material-symbols-outlined text-base">person</span>
                    {speaker}
                  </span>
                ))}
              </div>
            </div>
          )
        }

        <div class="prose prose-invert prose-lg max-w-none
          prose-headings:text-white prose-headings:font-display
          prose-p:text-text-body prose-p:font-light
          prose-table:text-text-body
          prose-th:text-white prose-th:font-medium
          prose-td:text-text-secondary prose-td:font-light
          prose-tr:border-white/10
          prose-strong:text-white
          prose-a:text-green hover:prose-a:text-green-light">
          <Content />
        </div>

        <div class="mt-16 pt-8 border-t border-white/10">
          <a class="group inline-flex items-center justify-center px-8 py-4 rounded-full bg-green text-navy font-bold text-lg hover:bg-green-light transition-all hover:scale-105 hover:shadow-[0_0_20px_rgba(76,189,148,0.4)]" href={event.data.meetupLink} target="_blank" rel="noopener noreferrer">
            View on Meetup
            <span class="material-symbols-outlined ml-2 group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Base>