---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const allEvents = await getCollection("events");

const realEvents = allEvents.filter((e) => e.id !== "july-2026-meetup");

const now = new Date();

const upcoming = realEvents
  .filter((e) => e.data.date > now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const past = realEvents
  .filter((e) => e.data.date <= now)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatDate(date: Date) {
  return date.toLocaleDateString("en-GB", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}
---

<Base title="Events — Data Engineers London">
  <Header />
  <main class="flex-grow">
    <section class="relative pt-32 pb-24 lg:pt-48 lg:pb-32 overflow-hidden bg-grid-pattern">
      <div class="absolute inset-0 bg-gradient-to-b from-navy/50 to-navy z-0"></div>
      <div class="relative z-10 max-w-7xl mx-auto px-6">
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white mb-6">
          Events
        </h1>
        <p class="text-xl text-white/60 font-light max-w-2xl">
          Join us at our monthly meetups — talks, networking, and community.
        </p>
      </div>
    </section>

    {
      upcoming.length > 0 && (
        <section class="py-24 bg-navy/95 border-t border-white/5">
          <div class="max-w-7xl mx-auto px-6">
            <div class="mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-white inline-block relative">
                Upcoming
                <div class="absolute -bottom-3 left-0 w-1/2 h-1 bg-green rounded-full"></div>
              </h2>
            </div>
            <div class="space-y-6">
              {
                upcoming.map((event) => (
                  <div class="bg-white/5 border border-green/30 rounded-2xl p-8 hover:border-green transition-colors backdrop-blur-sm">
                    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
                      <div class="space-y-3 flex-1">
                        <div class="flex flex-wrap items-center gap-3 text-sm">
                          <span class="inline-flex items-center gap-1.5 text-green">
                            <span class="material-symbols-outlined text-lg">calendar_month</span>
                            {formatDate(event.data.date)}
                          </span>
                          <span class="text-white/30">|</span>
                          <span class="inline-flex items-center gap-1.5 text-white/70">
                            <span class="material-symbols-outlined text-lg">location_on</span>
                            {event.data.venue}
                          </span>
                        </div>
                        <h3 class="text-xl md:text-2xl font-bold text-white">
                          <a href={`/events/${event.id}`} class="hover:text-green transition-colors">{event.data.title}</a>
                        </h3>
                        <p class="text-white/70 font-light">{event.data.description}</p>
                        <div class="flex flex-wrap gap-2">
                          {event.data.speakers.map((speaker) => (
                            <span class="inline-flex items-center px-3 py-1 rounded-full bg-green/10 text-green text-sm font-medium">
                              {speaker}
                            </span>
                          ))}
                        </div>
                      </div>
                      <div class="shrink-0">
                        <a class="group inline-flex items-center justify-center px-6 py-3 rounded-full bg-green text-navy font-semibold hover:bg-green-light transition-all hover:scale-105 hover:shadow-[0_0_20px_rgba(76,189,148,0.4)]" href={event.data.meetupLink} rel="noopener noreferrer" target="_blank">
                          RSVP
                          <span class="material-symbols-outlined ml-1 group-hover:translate-x-1 transition-transform">arrow_forward</span>
                        </a>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </section>
      )
    }

    {
      past.length > 0 && (
        <section class="py-24 bg-navy/95 border-t border-white/5">
          <div class="max-w-7xl mx-auto px-6">
            <div class="mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-white inline-block relative">
                Past Events
                <div class="absolute -bottom-3 left-0 w-1/2 h-1 bg-green rounded-full"></div>
              </h2>
            </div>
            <div class="space-y-4">
              {
                past.map((event) => (
                  <a href={`/events/${event.id}`} class="block bg-white/5 border border-white/10 rounded-2xl p-6 transition-colors backdrop-blur-sm opacity-70 hover:opacity-100 hover:border-green">
                    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                      <div class="space-y-1">
                        <div class="flex items-center gap-2 text-sm text-white/50">
                          <span class="material-symbols-outlined text-base">calendar_month</span>
                          {formatDate(event.data.date)}
                        </div>
                        <h3 class="text-lg font-bold text-white">{event.data.title}</h3>
                        <p class="text-sm text-white/50">{event.data.venue}</p>
                        <div class="flex flex-wrap gap-1.5 mt-2">
                          {event.data.speakers.map((speaker) => (
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-white/5 text-white/60 text-xs font-medium">
                              {speaker}
                            </span>
                          ))}
                        </div>
                      </div>
                    </div>
                  </a>
                ))
              }
            </div>
          </div>
        </section>
      )
    }

    {
      upcoming.length === 0 && past.length === 0 && (
        <section class="py-24 bg-navy/95 border-t border-white/5">
          <div class="max-w-7xl mx-auto px-6 text-center">
            <p class="text-white/50 text-lg font-light">No events yet. Check back soon!</p>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</Base>
