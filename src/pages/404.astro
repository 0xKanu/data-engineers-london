---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Page Not Found — Data Engineers London" description="Sorry, we couldn't find that page.">
  <Header />
  <main id="main-content" class="flex-grow">
    <section class="relative pt-32 pb-24 lg:pt-48 lg:pb-32 overflow-hidden bg-grid-pattern">
      <div class="absolute inset-0 bg-gradient-to-b from-navy/50 to-navy z-0"></div>
      <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
        <h1 class="text-6xl md:text-8xl font-bold tracking-tight text-white/20 mb-6">
          404
        </h1>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
          Page Not Found
        </h2>
        <p class="text-xl text-text-dim font-light mb-12 max-w-xl mx-auto">
          Sorry, we couldn&rsquo;t find that page. It may have moved, or the link you followed might be out of date.
        </p>
        <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
          <a class="group flex items-center justify-center px-8 py-4 rounded-full bg-green text-navy font-bold text-lg hover:bg-green-light transition-all hover:scale-105 hover:shadow-[0_0_20px_rgba(76,189,148,0.4)]" href="/">
            <span class="material-symbols-outlined mr-2">home</span>
            Back to Homepage
          </a>
          <a class="group flex items-center justify-center px-8 py-4 rounded-full bg-orange text-navy font-bold text-lg hover:bg-orange-dark transition-all hover:scale-105 hover:shadow-[0_0_30px_rgba(243,112,70,0.4)]" href="/events">
            <span class="material-symbols-outlined mr-2">calendar_month</span>
            Browse Events
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>