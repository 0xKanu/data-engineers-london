---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const allEvents = await getCollection("events");
const eventCount = allEvents.filter((e) => e.id !== "july-2026-meetup").length;
---

<Base title="About — Data Engineers London" description="Data Engineers London is a community-driven group dedicated to bringing together data professionals across London.">
  <Header />
  <main id="main-content" class="flex-grow">

    <section class="relative pt-32 pb-24 lg:pt-48 lg:pb-32 overflow-hidden bg-grid-pattern">
      <div class="absolute inset-0 bg-gradient-to-b from-navy/50 to-navy z-0"></div>
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-green rounded-full mix-blend-multiply filter blur-[128px] opacity-20 animate-pulse"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-orange rounded-full mix-blend-multiply filter blur-[128px] opacity-10"></div>
      <div class="relative z-10 max-w-7xl mx-auto px-6">
        <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-white mb-6">
          About Us
        </h1>
        <p class="text-xl text-text-dim font-light max-w-2xl">
          London’s community for data engineers — bringing together 2,000+ professionals for monthly meetups, talks, and networking.
        </p>
      </div>
    </section>

    <section class="py-24 bg-navy/95 border-t border-white/5">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-24">
          <div class="space-y-6 text-text-body text-lg font-light leading-normal">
            <p>
              Data Engineers London is a community-driven group dedicated to bringing together data professionals, engineers, architects, and enthusiasts across the capital. We provide a space to share knowledge, discuss best practices, and explore the latest technologies shaping the modern data stack.
            </p>
            <p>
              Whether you’re building massive data pipelines, architecting real-time streaming platforms, or just starting your journey in data engineering, you’ll find a welcoming community ready to learn and grow together.
            </p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors group backdrop-blur-sm sm:col-span-2">
              <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 rounded-xl bg-green/10 flex items-center justify-center text-green group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">groups</span>
                </div>
                <h3 class="text-3xl font-bold text-white">2,000+</h3>
              </div>
              <p class="text-text-dim font-medium">Active Members</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors group backdrop-blur-sm">
              <div class="w-12 h-12 rounded-xl bg-orange/10 flex items-center justify-center text-orange mb-4 group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">event</span>
              </div>
                <h3 class="text-2xl font-bold text-white mb-1">{eventCount}+</h3>
              <p class="text-text-dim text-sm font-medium">Events Hosted</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors group backdrop-blur-sm">
              <div class="w-12 h-12 rounded-xl bg-green/10 flex items-center justify-center text-green mb-4 group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">calendar_month</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-1">Monthly</h3>
              <p class="text-text-dim text-sm font-medium">Meetups</p>
            </div>
          </div>
        </div>

        <div>
          <div class="mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-white inline-block relative">
              Organisers
              <div class="absolute -bottom-3 left-0 w-1/2 h-1 bg-green rounded-full"></div>
            </h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-navy border border-green/30 rounded-2xl p-8 flex flex-col items-center text-center">
              <div class="w-20 h-20 rounded-full bg-green/10 flex items-center justify-center mb-6 border-2 border-green/50">
                <span class="material-symbols-outlined text-4xl text-green">person</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-1">Anna Aleshko</h3>
              <p class="text-green font-medium mb-4">Founder & Lead Organiser</p>
              <p class="text-text-body font-light text-sm mb-6 flex-grow">
                Anna is a data engineer passionate about building London’s data engineering community. She founded Data Engineers London in 2023 to create a space for practitioners to connect and share real-world knowledge.
              </p>
              <a class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-green/10 text-green hover:bg-green hover:text-navy transition-colors mt-auto" href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
                </svg>
              </a>
            </div>
            <div class="bg-navy border border-green/30 rounded-2xl p-8 flex flex-col items-center text-center">
              <div class="w-20 h-20 rounded-full bg-green/10 flex items-center justify-center mb-6 border-2 border-green/50">
                <span class="material-symbols-outlined text-4xl text-green">person</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-1">Luke Ashe-Browne</h3>
              <p class="text-green font-medium mb-4">Organiser</p>
              <p class="text-text-body font-light text-sm mb-6 flex-grow">
                Luke is a data engineer and regular speaker at the meetup. He brings deep technical expertise and helps shape the direction of the community.
              </p>
              <a class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-green/10 text-green hover:bg-green hover:text-navy transition-colors mt-auto" href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
                </svg>
              </a>
            </div>
            <div class="bg-navy border border-green/30 rounded-2xl p-8 flex flex-col items-center text-center">
              <div class="w-20 h-20 rounded-full bg-green/10 flex items-center justify-center mb-6 border-2 border-green/50">
                <span class="material-symbols-outlined text-4xl text-green">person</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-1">Sam Malcolm</h3>
              <p class="text-green font-medium mb-4">Organiser</p>
              <p class="text-text-body font-light text-sm mb-6 flex-grow">
                Sam is a data engineer specialising in real-time data at global scale. He is a regular speaker on streaming architectures and event-driven systems.
              </p>
              <a class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-green/10 text-green hover:bg-green hover:text-navy transition-colors mt-auto" href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-navy relative border-t border-white/5 overflow-hidden" id="sponsorship">
      <div class="absolute inset-0 bg-grid-pattern opacity-10"></div>
      <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="mb-16 text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-white inline-block relative mb-6">
            Get in Touch
            <div class="absolute -bottom-3 left-0 w-1/2 h-1 bg-green rounded-full"></div>
          </h2>
          <p class="text-text-secondary text-lg max-w-2xl mx-auto font-light leading-normal">
            Want to sponsor an event, give a talk, or just say hello? We'd love to hear from you.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
          <a class="group relative inline-flex items-center justify-center px-10 py-4 rounded-full bg-green text-navy font-bold text-lg hover:bg-green-light transition-all hover:scale-105 hover:shadow-[0_0_20px_rgba(76,189,148,0.4)]" href="mailto:events@dataengineerslondon.com">
            <span class="material-symbols-outlined mr-2">mail</span>
            events@dataengineerslondon.com
          </a>
          <a class="group relative inline-flex items-center justify-center px-10 py-4 rounded-full bg-orange text-navy font-bold text-lg hover:bg-orange-dark transition-all hover:scale-105 hover:shadow-[0_0_30px_rgba(243,112,70,0.4)]" href="https://forms.gle/TyJtMphUsrk2TTK67" target="_blank" rel="noopener noreferrer">
            <span class="material-symbols-outlined mr-2">mic</span>
            Submit a Talk
            <span class="material-symbols-outlined ml-2 group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Base>